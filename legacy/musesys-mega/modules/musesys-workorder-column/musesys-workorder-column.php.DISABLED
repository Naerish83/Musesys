<?php
/**
 * MuseSys Work Order Column Module
 * Adds Work Order # columns to WooCommerce Orders + line items
 * Cleaned, modernized, constants protected, no site-locks
 */

if ( ! defined( 'ABSPATH' ) ) {
    exit;
}

/* ---------------------------------------------------------------------------
   CONSTANTS — PROTECTED AGAINST REDECLARATION
--------------------------------------------------------------------------- */

defined('MUSE_WO_FIELD_KEY')              || define( 'MUSE_WO_FIELD_KEY',              '_muse_workorder' );
defined('MUSE_WO_TOGGLE_KEY')             || define( 'MUSE_WO_TOGGLE_KEY',             '_muse_workorder_toggle' );
defined('MUSE_WO_REQUIRE_TOGGLE')         || define( 'MUSE_WO_REQUIRE_TOGGLE',         '_muse_workorder_required' );
defined('MUSE_WO_PROPAGATE_TO_ITEMS')     || define( 'MUSE_WO_PROPAGATE_TO_ITEMS',     '_muse_workorder_propagate' );
defined('MUSE_WO_ITEM_NOTE_KEY')          || define( 'MUSE_WO_ITEM_NOTE_KEY',          '_muse_workorder_item_note' );
defined('MUSE_WO_ITEM_META_WO')           || define( 'MUSE_WO_ITEM_META_WO',           '_muse_lineitem_workorder' );
defined('MUSE_WO_ITEM_META_NOTE')         || define( 'MUSE_WO_ITEM_META_NOTE',         '_muse_lineitem_workorder_note' );
defined('MUSE_WO_REGEX')                  || define( 'MUSE_WO_REGEX',                  '/^\d{7}$/' ); // 7-digit WO#

/* ---------------------------------------------------------------------------
   CLASS
--------------------------------------------------------------------------- */

class MuseSys_WorkOrder_Column {

    /** @var MuseSys_WorkOrder_Column */
    private static $instance = null;

    /**
     * Initialize singleton
     */
    public static function init() {
        if ( self::$instance === null ) {
            self::$instance = new self();
        }

        // HPOS Compatibility Declaration
        add_action('before_woocommerce_init', function() {
            if (class_exists(\Automattic\WooCommerce\Utilities\FeaturesUtil::class)) {
                \Automattic\WooCommerce\Utilities\FeaturesUtil::declare_compatibility('custom_order_tables', __FILE__, true);
            }
        });

        return self::$instance;
    }

    /**
     * Register hooks
     */
    private function __construct() {

        // Add custom column to admin orders table
        add_filter( 'manage_edit-shop_order_columns',        [ $this, 'add_order_column' ], 20 );
        add_action( 'manage_shop_order_posts_custom_column', [ $this, 'render_order_column' ], 20, 2 );

        // Save Work Order meta during checkout
        add_action( 'woocommerce_checkout_update_order_meta', [ $this, 'save_workorder_meta' ], 20 );

        // Propagate Work Order to line items
        add_action( 'woocommerce_checkout_create_order_line_item', [ $this, 'save_lineitem_meta' ], 20, 4 );

        // Display Work Order inside order edit screen
        add_action( 'woocommerce_admin_order_data_after_billing_address', [ $this, 'admin_display_workorder' ], 20, 1 );
    }

    /* ---------------------------------------------------------------------------
        ADMIN ORDER COLUMN
    --------------------------------------------------------------------------- */

    public function add_order_column( $columns ) {
        $new_columns = [];

        foreach ( $columns as $key => $label ) {
            $new_columns[$key] = $label;

            // Insert WO column after order status
            if ( $key === 'order_status' ) {
                $new_columns['muse_workorder'] = 'Work Order #';
            }
        }
        return $new_columns;
    }

    public function render_order_column( $column, $post_id ) {
        if ( $column !== 'muse_workorder' ) {
            return;
        }

        $order = wc_get_order( $post_id );
        if ( ! $order ) { echo '—'; return; }

        $wo = $order->get_meta( MUSE_WO_FIELD_KEY );
        echo $wo ? esc_html( $wo ) : '<span style="opacity:0.4;">—</span>';
    }

    /* ---------------------------------------------------------------------------
        SAVE CHECKOUT DATA
    --------------------------------------------------------------------------- */

    public function save_workorder_meta( $order_id ) {
        if ( empty( $_POST['muse_workorder'] ) ) {
            return;
        }

        $wo = sanitize_text_field( wp_unslash( $_POST['muse_workorder'] ) );

        if ( preg_match( MUSE_WO_REGEX, $wo ) ) {
            $order = wc_get_order( $order_id );
            if ( $order ) {
                $order->update_meta_data( MUSE_WO_FIELD_KEY, $wo );
                $order->save();
            }
        }
    }

    /* ---------------------------------------------------------------------------
        PROPAGATE TO LINE ITEMS
    --------------------------------------------------------------------------- */

    public function save_lineitem_meta( $item, $cart_item_key, $values, $order ) {

        $wo = $order->get_meta( MUSE_WO_FIELD_KEY );
        if ( ! $wo ) {
            return;
        }

        $item->add_meta_data( MUSE_WO_ITEM_META_WO, $wo, true );

        if ( ! empty( $_POST['muse_workorder_note'] ) ) {
            $note = sanitize_text_field( wp_unslash( $_POST['muse_workorder_note'] ) );
            $item->add_meta_data( MUSE_WO_ITEM_META_NOTE, $note, true );
        }
    }

    /* ---------------------------------------------------------------------------
        DISPLAY WORK ORDER IN ADMIN ORDER SCREEN
    --------------------------------------------------------------------------- */

    public function admin_display_workorder( $order ) {
        $wo = $order->get_meta( MUSE_WO_FIELD_KEY );

        echo '<p><strong>Work Order #:</strong> ' . ( $wo ? esc_html( $wo ) : '—' ) . '</p>';
    }
}

/* ---------------------------------------------------------------------------
   BOOT
--------------------------------------------------------------------------- */

MuseSys_WorkOrder_Column::init();
